APP_NAME=ISCPP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=iscpp
DB_USERNAME=iscpp
DB_PASSWORD=iscpp

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sqlite

CACHE_STORE=file

USER_DEFAULT_TIMEZONE='Europe/Berlin'
ISCPP_EVENTS_ENABLED=true
ISCPP_EVENTS_RETENTION_DAYS=90
ISCPP_WEBHOOK_TIMEOUT=10
ISCPP_WEBHOOK_FAILURE_THRESHOLD=10
ISCPP_WEBHOOK_ALLOW_PRIVATE_HOSTS=false
ISCPP_HEALTHSCORE_DEFAULT_THRESHOLD=100
